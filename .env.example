# --- Repository to index (local path or GitHub URL) ---
GITCONTEXT_REPO=https://github.com/pallets/click
GITHUB_TOKEN=            # optional but strongly recommended: PRs/issues API (5000 req/h vs 60)

# --- LLM (answer generation + LLM-judge in eval) ---
GITCONTEXT_LLM_PROVIDER=anthropic     # anthropic | openai | none
GITCONTEXT_LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# GITCONTEXT_OPENAI_BASE_URL=http://localhost:11434/v1   # any OpenAI-compatible server (Ollama, vLLM)

# --- Embeddings / reranker ---
GITCONTEXT_EMBEDDING_PROVIDER=fastembed   # fastembed (local ONNX) | openai | hash (offline tests)
GITCONTEXT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
GITCONTEXT_RERANKER=cross-encoder         # cross-encoder | lexical | none
GITCONTEXT_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# --- Vector DB ---
# GITCONTEXT_QDRANT_URL=http://localhost:6333   # unset => embedded local mode in ./.gitcontext/qdrant

# --- Freshness ---
GITCONTEXT_AUTO_SYNC_SECONDS=0            # >0 => API polls the repo and re-indexes changed files
GITCONTEXT_SYNC_ON_QUERY=false            # true => sync if HEAD moved before answering
GITCONTEXT_WEBHOOK_SECRET=                # HMAC secret for POST /webhook/github

# --- Deployment (see README: "Deploy: Vercel frontend + hosted backend") ---
GITCONTEXT_API_KEY=                       # require x-api-key on all endpoints except /health and the webhook
GITCONTEXT_CORS_ORIGINS=                  # e.g. https://myapp.vercel.app (only if the browser calls the backend directly)
GITCONTEXT_AUTO_INDEX_ON_START=false      # true on a fresh server: index in the background at boot
# Vercel project env (not read by the backend): BACKEND_URL, BACKEND_API_KEY, ALLOW_ADMIN

# --- All-in-Qdrant backend (used by the all-Vercel deployment; see README) ---
# GITCONTEXT_BACKEND=qdrant
# GITCONTEXT_QDRANT_URL=https://<cluster>.cloud.qdrant.io
# GITCONTEXT_QDRANT_API_KEY=
# GITCONTEXT_COLLECTION_NAME=gitcontext      # same value for the indexer (GitHub Action) and the Vercel function
# GITCONTEXT_RATE_LIMIT_PER_MIN=20           # serverless: best-effort per-IP limit
# GITCONTEXT_EMBEDDING_PROVIDER=voyage       # optional hosted embeddings (VOYAGE_API_KEY); free accounts w/o a card: 3 req/min
