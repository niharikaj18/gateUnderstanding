+      --accent: #60a5fa; --accent-ink: #0c0a09; --ok: #4ade80; --warn: #fbbf24; --bad: #f87171;
+      --code-bg: #0c0a09; --chip: #1e3a8a; --chip-ink: #bfdbfe;
+    }
+  }
