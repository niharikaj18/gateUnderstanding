+  .examples button { border: 1px solid var(--line); background: var(--panel); color: var(--ink); border-radius: 10px; padding: 8px 14px; max-width: 100%; text-align: left; }
+  .examples button:hover { border-color: var(--accent); }
+  .msg { margin: 0 0 18px; }
+  .q { background: var(--accent); color: var(--accent-ink); padding: 9px 14px; border-radius: 14px 14px 4px 14px; margin-left: auto; width: fit-content; max-width: 85%; white-space: pre-wrap; overflow-wrap: anywhere; }
+  .a { background: var(--panel); border: 1px solid var(--line); border-radius: 14px 14px 14px 4px; padding: 12px 16px; margin-top: 10px; overflow-wrap: anywhere; }
