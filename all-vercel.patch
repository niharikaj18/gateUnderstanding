+++ b/vercel/gitcontext/index/lexical.py
@@ -0,0 +1,259 @@
+"""Lexical index: SQLite FTS5 (BM25) + chunk store + file manifest + metadata.
+
+Why FTS5 instead of an in-memory BM25 lib: it is persistent, incremental (delete/insert by rowid),
+supports phrase and NEAR queries (exact error messages) and column weighting (symbol/path boost).
+Identifiers are indexed twice: whole (`parse_user_id`) and split (`parse user id`), so both
+`parse_user_id` and "parse user" find the same function.
+"""
+from __future__ import annotations
+
+import json
+import re
+import sqlite3
+import threading
+from dataclasses import dataclass
+from pathlib import Path
+
+from ..models import Chunk
+
+_WORD = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
+STOP = set("""a an the of to in on for and or is are was were be been how what why when where which who whom does do did
+can could should would it its this that these those with from by as at into about there their we you i me my our not
+no yes if then than so such via use used using get gets make makes work works code file files function class""".split())
+
+
+def split_identifier(tok: str) -> list[str]:
+    t = re.sub(r"([a-z0-9])([A-Z])", r"\1 \2", tok)
+    t = re.sub(r"([A-Z]+)([A-Z][a-z])", r"\1 \2", t)
+    return [p.lower() for p in re.split(r"[_\s]+", t) if p]
+
+
+def is_identifier_like(tok: str) -> bool:
+    return "_" in tok.strip("_") or bool(re.search(r"[a-z][A-Z]", tok)) or (tok.isupper() and len(tok) > 3)
+
+
+def expand_identifiers(text: str) -> str:
+    out = []
+    for tok in _WORD.findall(text):
+        if is_identifier_like(tok):
+            parts = split_identifier(tok)
+            if len(parts) > 1:
+                out.extend(parts)
+    return " ".join(out)
+
+
+@dataclass
+class QueryProfile:
+    terms: list[str]
+    identifiers: list[str]
+    phrases: list[str]
+
+    @property
+    def exact_signal(self) -> bool:
+        return bool(self.identifiers or self.phrases)
+
+
+_ERR_RE = re.compile(r"(?:\b[\w.]*(?:Error|Exception|Warning)\b|error|failed|cannot|unable to|invalid|unexpected)[:\s-]+(.{12,})", re.I)
+
+
+def profile_query(q: str) -> QueryProfile:
+    phrases = [p.strip() for p in re.findall(r"\"([^\"]{4,})\"|'([^']{6,})'|`([^`]{4,})`", q) for p in p if p.strip()]
+    quoted = {p for p in phrases}
+    # a quoted single identifier is an identifier, not a phrase
+    phrases = [p for p in phrases if len(_WORD.findall(p)) >= 2]
+    m = _ERR_RE.search(q)
+    if m:
+        phrases.append(m.group(1).strip(" .?\"'`"))
+    words = _WORD.findall(q)
+    ids = [w for w in words if is_identifier_like(w)] + [w for w in quoted if _WORD.fullmatch(w)]
+    ids += re.findall(r"\b([A-Za-z_]\w*(?:\.[A-Za-z_]\w*)+)\b", q)  # dotted paths
+    terms = [w.lower() for w in words if w.lower() not in STOP and len(w) > 1]
+    return QueryProfile(terms=list(dict.fromkeys(terms))[:24], identifiers=list(dict.fromkeys(ids)), phrases=phrases)
+
+
+def _fts_quote(t: str) -> str:
+    return '"' + t.replace('"', '""') + '"'
+
+
+def query_tokens(profile: QueryProfile) -> list[str]:
+    """Terms used for keyword retrieval: query words, identifiers, and identifier sub-tokens."""
+    toks: list[str] = list(profile.terms)
+    for ident in profile.identifiers:
+        for part in re.split(r"[.]", ident):
+            toks.append(part.lower())
+            toks.extend(split_identifier(part))
+    return [t for t in dict.fromkeys(toks) if t and t not in STOP][:40]
+
+
+def build_match(profile: QueryProfile) -> str | None:
+    return " OR ".join(_fts_quote(t) for t in query_tokens(profile)) or None
+
+
+def build_phrase_match(profile: QueryProfile) -> str | None:
+    qs = []
+    for ph in profile.phrases:
+        words = [w.lower() for w in re.findall(r"[A-Za-z0-9_]+", ph)][:12]
+        if len(words) >= 2:
+            qs.append(_fts_quote(" ".join(words)))
+            qs.append("NEAR(" + " ".join(_fts_quote(w) for w in words) + ", 8)")
+    return " OR ".join(qs) or None
+
+
+SCHEMA = """
+CREATE TABLE IF NOT EXISTS chunks(
+  rowid INTEGER PRIMARY KEY AUTOINCREMENT, id TEXT UNIQUE NOT NULL, key TEXT, source_type TEXT, path TEXT,
+  symbol TEXT, author TEXT, date TEXT, data TEXT NOT NULL);
+CREATE INDEX IF NOT EXISTS idx_chunks_path ON chunks(path);
+CREATE INDEX IF NOT EXISTS idx_chunks_type ON chunks(source_type);
+CREATE INDEX IF NOT EXISTS idx_chunks_key ON chunks(key);
+CREATE VIRTUAL TABLE IF NOT EXISTS fts USING fts5(
+  raw, split, symbols, tokenize="unicode61 tokenchars '_'");
+CREATE TABLE IF NOT EXISTS files(path TEXT PRIMARY KEY, blob_sha TEXT, chunk_ids TEXT, indexed_at TEXT);
+CREATE TABLE IF NOT EXISTS meta(k TEXT PRIMARY KEY, v TEXT);
+"""
+
+
+class LexicalStore:
+    def __init__(self, path: str | Path):
+        if str(path) != ":memory:":
+            Path(path).parent.mkdir(parents=True, exist_ok=True)
+        self.db = sqlite3.connect(str(path), check_same_thread=False)
+        self.db.row_factory = sqlite3.Row
+        self.lock = threading.RLock()
+        with self.lock:
+            self.db.executescript(SCHEMA)
+
+    # ---- writes ---------------------------------------------------------------------------
+    def upsert(self, chunks: list[Chunk]) -> None:
+        with self.lock, self.db:
+            self._delete_ids([c.id for c in chunks])
+            for c in chunks:
+                cur = self.db.execute(
+                    "INSERT INTO chunks(id,key,source_type,path,symbol,author,date,data) VALUES(?,?,?,?,?,?,?,?)",
+                    (c.id, c.key, c.source_type, c.path, c.symbol, c.author, c.date, json.dumps(c.to_dict())))
+                sym_txt = f"{c.path} {c.symbol}"
+                self.db.execute(
+                    "INSERT INTO fts(rowid,raw,split,symbols) VALUES(?,?,?,?)",
+                    (cur.lastrowid, c.text, expand_identifiers(c.text),
+                     f"{sym_txt} {expand_identifiers(sym_txt)} {re.sub(r'[/.]', ' ', sym_txt)}"))
+
+    def _delete_ids(self, ids: list[str]) -> None:
+        for i in range(0, len(ids), 500):
+            batch = ids[i : i + 500]
+            ph = ",".join("?" * len(batch))
+            rows = self.db.execute(f"SELECT rowid FROM chunks WHERE id IN ({ph})", batch).fetchall()
+            if rows:
+                rph = ",".join("?" * len(rows))
+                self.db.execute(f"DELETE FROM fts WHERE rowid IN ({rph})", [r[0] for r in rows])
+                self.db.execute(f"DELETE FROM chunks WHERE id IN ({ph})", batch)
+
+    def delete(self, ids: list[str]) -> None:
+        with self.lock, self.db:
+            self._delete_ids(ids)
+
+    def delete_source(self, source_type: str) -> list[str]:
+        with self.lock, self.db:
+            ids = [r[0] for r in self.db.execute("SELECT id FROM chunks WHERE source_type=?", (source_type,))]
+            self._delete_ids(ids)
+            return ids
+
+    # ---- manifest / meta ----------------------------------------------------------------
+    def manifest(self) -> dict[str, tuple[str, list[str]]]:
+        with self.lock:
+            return {r["path"]: (r["blob_sha"], json.loads(r["chunk_ids"]))
+                    for r in self.db.execute("SELECT * FROM files")}
+
+    def set_file(self, path: str, blob_sha: str, chunk_ids: list[str], when: str) -> None:
+        with self.lock, self.db:
+            self.db.execute("INSERT OR REPLACE INTO files VALUES(?,?,?,?)", (path, blob_sha, json.dumps(chunk_ids), when))
+
+    def drop_file(self, path: str) -> None:
+        with self.lock, self.db:
+            self.db.execute("DELETE FROM files WHERE path=?", (path,))
+
+    def get_meta(self, k: str, default: str = "") -> str:
+        with self.lock:
+            r = self.db.execute("SELECT v FROM meta WHERE k=?", (k,)).fetchone()
+            return r["v"] if r else default
+
+    def set_meta(self, k: str, v: str) -> None:
+        with self.lock, self.db:
+            self.db.execute("INSERT OR REPLACE INTO meta VALUES(?,?)", (k, v))
+
+    # ---- reads ------------------------------------------------------------------------------
+    def get_many(self, ids: list[str]) -> dict[str, Chunk]:
+        out: dict[str, Chunk] = {}
+        with self.lock:
+            for i in range(0, len(ids), 500):
+                batch = ids[i : i + 500]
+                ph = ",".join("?" * len(batch))
+                for r in self.db.execute(f"SELECT id,data FROM chunks WHERE id IN ({ph})", batch):
+                    out[r["id"]] = Chunk.from_dict(json.loads(r["data"]))
+        return out
+
+    def count(self, source_type: str | None = None) -> int:
+        with self.lock:
+            if source_type:
+                return self.db.execute("SELECT COUNT(*) FROM chunks WHERE source_type=?", (source_type,)).fetchone()[0]
+            return self.db.execute("SELECT COUNT(*) FROM chunks").fetchone()[0]
+
+    def counts_by_type(self) -> dict[str, int]:
+        with self.lock:
+            return {r[0]: r[1] for r in self.db.execute("SELECT source_type, COUNT(*) FROM chunks GROUP BY 1")}
+
+    def iter_chunks(self, source_type: str | None = None):
+        with self.lock:
+            q, args = "SELECT data FROM chunks", ()
+            if source_type:
+                q, args = q + " WHERE source_type=?", (source_type,)
+            rows = self.db.execute(q, args).fetchall()
+        for r in rows:
+            yield Chunk.from_dict(json.loads(r["data"]))
+
+    # ---- search ---------------------------------------------------------------------------------
+    def _filters(self, source_types, path_prefix):
+        sql, args = "", []
+        if source_types:
+            sql += f" AND c.source_type IN ({','.join('?' * len(source_types))})"
+            args += list(source_types)
+        if path_prefix:
+            sql += " AND (c.path = ? OR c.path LIKE ?)"
+            args += [path_prefix.rstrip("/"), path_prefix.rstrip("/") + "/%"]
+        return sql, args
+
+    def _run(self, match: str | None, k: int, source_types, path_prefix) -> list[tuple[str, float]]:
+        if not match:
+            return []
+        fsql, fargs = self._filters(source_types, path_prefix)
+        q = ("SELECT c.id, bm25(fts, 1.0, 0.5, 4.0) AS s FROM fts JOIN chunks c ON c.rowid = fts.rowid "
+             f"WHERE fts MATCH ?{fsql} ORDER BY s LIMIT ?")
+        with self.lock:
+            try:
+                return [(r[0], -r[1]) for r in self.db.execute(q, [match, *fargs, k])]
+            except sqlite3.OperationalError:
+                return []  # malformed MATCH from odd user input: degrade to no lexical hits
+
+    def bm25(self, profile: QueryProfile, k: int, source_types=None, path_prefix=None):
+        return self._run(build_match(profile), k, source_types, path_prefix)
+
+    def phrase(self, profile: QueryProfile, k: int, source_types=None, path_prefix=None):
+        return self._run(build_phrase_match(profile), k, source_types, path_prefix)
+
+    def symbol_exact(self, profile: QueryProfile, k: int, source_types=None, path_prefix=None):
+        """Chunks whose symbol equals / ends with a queried identifier. A qualified name
+        (`Option.get_help_record`) ranks its exact match before same-named methods of other classes."""
+        names = list(dict.fromkeys(i.split(".")[-1] for i in profile.identifiers))
+        if not names:
+            return []
+        qualified = list(dict.fromkeys(i for i in profile.identifiers if "." in i))
+        fsql, fargs = self._filters(source_types, path_prefix)
+        conds = " OR ".join(["c.symbol = ? OR c.symbol LIKE ?"] * len(names))
+        args = [x for n in names for x in (n, f"%.{n}")]
+        order, oargs = "", []
+        if qualified:
+            order = f" ORDER BY CASE WHEN c.symbol IN ({','.join('?' * len(qualified))}) THEN 0 ELSE 1 END"
+            oargs = qualified
+        with self.lock:
+            rows = self.db.execute(
+                f"SELECT c.id FROM chunks c WHERE ({conds}){fsql}{order} LIMIT ?", [*args, *fargs, *oargs, k]).fetchall()
+        return [(r[0], 1.0) for r in rows]
diff --git a/vercel/gitcontext/index/qdrant_unified.py b/vercel/gitcontext/index/qdrant_unified.py
new file mode 100644
index 0000000..ded930a
--- /dev/null
+++ b/vercel/gitcontext/index/qdrant_unified.py
@@ -0,0 +1,265 @@
+"""All-in-Qdrant backend: one object that is both the VectorStore and the lexical/chunk store.
+
+Why: serverless functions have no persistent disk, so the SQLite FTS5 index cannot live next to them.
+Here every chunk is one Qdrant point holding
+
+  * a dense vector (semantic search),
+  * a sparse BM25-style vector with server-side IDF (keyword search; see index/sparse.py),
+  * the full chunk as payload (so retrieval needs no second store),
+  * filterable fields: source_type, path prefixes, symbol leaf names, is_file.
+
+The four rankers used by the hybrid retriever map to Qdrant like this:
+  dense  -> query_points(using="dense")
+  bm25   -> query_points(using="sparse")
+  phrase -> sparse candidates (top 100) re-checked client-side for the exact/NEAR phrase
+  symbol -> payload filter on `symbol_leaf`
+The file manifest used for staleness is derived from point payloads (path + blob_sha), and index metadata
+(indexed commit, embedder, ...) lives in a tiny companion collection, so any client can read freshness.
+"""
+from __future__ import annotations
+
+import re
+import uuid
+from typing import Iterator
+
+from ..models import NS, SOURCE_TYPES, Chunk
+from .lexical import QueryProfile, query_tokens  # noqa: F401  (query_tokens re-exported for callers)
+from .sparse import encode_chunk, encode_phrase_words, encode_query
+
+DENSE, SPARSE = "dense", "sparse"
+PHRASE_POOL = 100
+
+
+def _leaf(symbol: str) -> list[str]:
+    return [symbol.split(".")[-1].lower()] if symbol else []
+
+
+class QdrantUnified:
+    def __init__(self, collection: str, url: str | None = None, api_key: str | None = None,
+                 path: str | None = None, in_memory: bool = False, client=None):
+        from qdrant_client import QdrantClient
+
+        self.collection, self.meta_collection = collection, f"{collection}_meta"
+        self.remote = bool(url) and client is None
+        if client is not None:
+            self.client = client
+        elif url:
+            self.client = QdrantClient(url=url, api_key=api_key, timeout=60)
+        elif in_memory or not path:
+            self.client = QdrantClient(":memory:")
+        else:
+            self.client = QdrantClient(path=str(path))
+
+    # ---- collection lifecycle -----------------------------------------------------------------
+    def _exists(self, name: str) -> bool:
+        return name in {c.name for c in self.client.get_collections().collections}
+
+    def ensure(self, dim: int) -> None:
+        from qdrant_client import models as qm
+
+        if self._exists(self.collection):
+            info = self.client.get_collection(self.collection)
+            existing = info.config.params.vectors[DENSE].size
+            if existing != dim:
+                raise RuntimeError(f"Collection '{self.collection}' has dim {existing} but the embedder produces "
+                                   f"{dim}. Re-run `gitcontext index --rebuild` after changing the embedding model.")
+        else:
+            self.client.create_collection(
+                self.collection,
+                vectors_config={DENSE: qm.VectorParams(size=dim, distance=qm.Distance.COSINE)},
+                sparse_vectors_config={SPARSE: qm.SparseVectorParams(modifier=qm.Modifier.IDF)})
+            if self.remote:  # payload indexes only exist on a Qdrant server
+                for f, schema in (("source_type", "keyword"), ("path_prefixes", "keyword"),
+                                  ("symbol_leaf", "keyword"), ("symbol_full", "keyword"), ("is_file", "bool")):
+                    try:
+                        self.client.create_payload_index(self.collection, f, getattr(qm.PayloadSchemaType, schema.upper()))
+                    except Exception:
+                        pass
+        if not self._exists(self.meta_collection):
+            self.client.create_collection(self.meta_collection,
+                                          vectors_config=qm.VectorParams(size=1, distance=qm.Distance.DOT))
+
+    def reset(self) -> None:
+        for name in (self.collection, self.meta_collection):
+            if self._exists(name):
+                self.client.delete_collection(name)
+
+    # ---- writes ---------------------------------------------------------------------------------------
+    def upsert(self, ids: list[str], vectors: list[list[float]], payloads: list[dict],
+               chunks: list[Chunk] | None = None) -> None:
+        from qdrant_client import models as qm
+
+        if chunks is None:
+            raise ValueError("QdrantUnified.upsert needs the chunks (it stores text + sparse vectors)")
+        for i in range(0, len(ids), 64):
+            pts = []
+            for j in range(i, min(i + 64, len(ids))):
+                c = chunks[j]
+                idx, val = encode_chunk(c)
+                payload = dict(payloads[j])
+                payload.update(chunk=c.to_dict(), symbol_leaf=_leaf(c.symbol) if c.source_type == "code" else [],
+                               symbol_full=[c.symbol.lower()] if c.source_type == "code" and c.symbol else [],
+                               is_file=bool(c.path and c.blob_sha), blob_sha=c.blob_sha)
+                pts.append(qm.PointStruct(id=ids[j], vector={DENSE: vectors[j], SPARSE: qm.SparseVector(indices=idx, values=val)},
+                                          payload=payload))
+            self.client.upsert(self.collection, points=pts)
+
+    def delete(self, ids: list[str]) -> None:
+        from qdrant_client import models as qm
+
+        for i in range(0, len(ids), 500):
+            self.client.delete(self.collection, points_selector=qm.PointIdsList(points=ids[i : i + 500]))
+
+    def delete_source(self, source_type: str) -> list[str]:
+        from qdrant_client import models as qm
+
+        if self._exists(self.collection):
+            self.client.delete(self.collection, points_selector=qm.FilterSelector(
+                filter=qm.Filter(must=[qm.FieldCondition(key="source_type", match=qm.MatchValue(value=source_type))])))
+        return []
+
+    # --- the LexicalStore write API is a no-op: everything was written by upsert() above -----------
+    def set_file(self, *a, **k) -> None: ...
+    def drop_file(self, *a, **k) -> None: ...
+
+    # ---- meta ------------------------------------------------------------------------------------------
+    def get_meta(self, k: str, default: str = "") -> str:
+        try:
+            r = self.client.retrieve(self.meta_collection, ids=[str(uuid.uuid5(NS, f"meta:{k}"))], with_payload=True)
+        except Exception:
+            return default
+        return r[0].payload["v"] if r else default
+
+    def set_meta(self, k: str, v: str) -> None:
+        from qdrant_client import models as qm
+
+        self.client.upsert(self.meta_collection, points=[qm.PointStruct(
+            id=str(uuid.uuid5(NS, f"meta:{k}")), vector=[1.0], payload={"k": k, "v": v})])
+
+    # ---- reads ----------------------------------------------------------------------------------------
+    def _filter(self, source_types=None, path_prefix=None, extra=None):
+        from qdrant_client import models as qm
+
+        must = list(extra or [])
+        if source_types:
+            must.append(qm.FieldCondition(key="source_type", match=qm.MatchAny(any=list(source_types))))
+        if path_prefix:
+            must.append(qm.FieldCondition(key="path_prefixes", match=qm.MatchValue(value=path_prefix.rstrip("/"))))
+        return qm.Filter(must=must) if must else None
+
+    def search(self, vector, limit, source_types=None, path_prefix=None) -> list[tuple[str, float]]:
+        res = self.client.query_points(self.collection, query=vector, using=DENSE, limit=limit,
+                                       query_filter=self._filter(source_types, path_prefix), with_payload=False)
+        return [(str(p.id), float(p.score)) for p in res.points]
+
+    def _sparse(self, idx, val, limit, source_types, path_prefix, payload=False):
+        from qdrant_client import models as qm
+
+        if not idx:
+            return []
+        return self.client.query_points(
+            self.collection, query=qm.SparseVector(indices=idx, values=val), using=SPARSE, limit=limit,
+            query_filter=self._filter(source_types, path_prefix), with_payload=payload).points
+
+    def bm25(self, profile: QueryProfile, k: int, source_types=None, path_prefix=None):
+        idx, val = encode_query(profile)
+        return [(str(p.id), float(p.score)) for p in self._sparse(idx, val, k, source_types, path_prefix)]
+
+    def phrase(self, profile: QueryProfile, k: int, source_types=None, path_prefix=None):
+        """Exact/NEAR phrase match (error messages), verified client-side on sparse candidates."""
+        out: list[tuple[str, float]] = []
+        for ph in profile.phrases:
+            words = [w.lower() for w in re.findall(r"[A-Za-z0-9_]+", ph)][:12]
+            if len(words) < 2:
+                continue
+            idx, val = encode_phrase_words(words)
+            for p in self._sparse(idx, val, PHRASE_POOL, source_types, path_prefix, payload=True):
+                text = [t.lower() for t in re.findall(r"[A-Za-z0-9_]+", p.payload["chunk"]["text"])]
+                if _has_phrase(text, words) and str(p.id) not in {i for i, _ in out}:
+                    out.append((str(p.id), float(p.score)))
+        return out[:k]
+
+    def symbol_exact(self, profile: QueryProfile, k: int, source_types=None, path_prefix=None):
+        """Chunks whose symbol equals a queried identifier. A qualified name (`Option.get_help_record`)
+        ranks its exact match before same-named methods of other classes."""
+        from qdrant_client import models as qm
+
+        def run(field: str, names: list[str], limit: int):
+            flt = self._filter(source_types, path_prefix,
+                               extra=[qm.FieldCondition(key=field, match=qm.MatchAny(any=names))])
+            pts, _ = self.client.scroll(self.collection, scroll_filter=flt, limit=limit, with_payload=False)
+            return [str(p.id) for p in pts]
+
+        qualified = list({i.lower() for i in profile.identifiers if "." in i})
+        leaves = list({i.split(".")[-1].lower() for i in profile.identifiers})
+        if not leaves:
+            return []
+        ids = run("symbol_full", qualified, k) if qualified else []
+        ids += [i for i in run("symbol_leaf", leaves, k) if i not in ids]
+        return [(i, 1.0) for i in ids[:k]]
+
+    def get_many(self, ids: list[str]) -> dict[str, Chunk]:
+        out: dict[str, Chunk] = {}
+        for i in range(0, len(ids), 100):
+            for p in self.client.retrieve(self.collection, ids=ids[i : i + 100], with_payload=["chunk"]):
+                out[str(p.id)] = Chunk.from_dict(p.payload["chunk"])
+        return out
+
+    # ---- inventory (manifest / counts / iteration) --------------------------------------------------
+    def _scroll(self, flt=None, payload=True) -> Iterator:
+        offset = None
+        while True:
+            pts, offset = self.client.scroll(self.collection, scroll_filter=flt, limit=500, offset=offset,
+                                             with_payload=payload, with_vectors=False)
+            yield from pts
+            if offset is None:
+                return
+
+    def manifest(self) -> dict[str, tuple[str, list[str]]]:
+        from qdrant_client import models as qm
+
+        if not self._exists(self.collection):
+            return {}
+        flt = qm.Filter(must=[qm.FieldCondition(key="is_file", match=qm.MatchValue(value=True))])
+        files: dict[str, tuple[str, list[str]]] = {}
+        for p in self._scroll(flt, payload=["path", "blob_sha"]):
+            path, sha = p.payload["path"], p.payload["blob_sha"]
+            files.setdefault(path, (sha, []))[1].append(str(p.id))
+        return files
+
+    def count(self, source_type: str | None = None) -> int:
+        from qdrant_client import models as qm
+
+        flt = (qm.Filter(must=[qm.FieldCondition(key="source_type", match=qm.MatchValue(value=source_type))])
+               if source_type else None)
+        return self.client.count(self.collection, count_filter=flt, exact=True).count
+
+    def counts_by_type(self) -> dict[str, int]:
+        if not self._exists(self.collection):
+            return {}
+        return {st: n for st in SOURCE_TYPES if (n := self.count(st))}
+
+    def iter_chunks(self, source_type: str | None = None) -> Iterator[Chunk]:
+        from qdrant_client import models as qm
+
+        flt = (qm.Filter(must=[qm.FieldCondition(key="source_type", match=qm.MatchValue(value=source_type))])
+               if source_type else None)
+        for p in self._scroll(flt, payload=["chunk"]):
+            yield Chunk.from_dict(p.payload["chunk"])
+
+
+def _has_phrase(text: list[str], words: list[str]) -> bool:
+    n = len(words)
+    if n > len(text):
+        return False
+    for i in range(len(text) - n + 1):  # contiguous match
+        if text[i : i + n] == words:
+            return True
+    pos: dict[str, list[int]] = {}
+    for i, t in enumerate(text):
+        if t in words:
+            pos.setdefault(t, []).append(i)
+    if len(pos) < len(set(words)):
+        return False
+    first = min(pos.values(), key=len)  # NEAR: all words within a window of len + 8 tokens
+    return any(all(any(abs(q - s) <= n + 8 for q in pos[w]) for w in pos) for s in first)
diff --git a/vercel/gitcontext/index/sparse.py b/vercel/gitcontext/index/sparse.py
new file mode 100644
index 0000000..cfa2e89
--- /dev/null
+++ b/vercel/gitcontext/index/sparse.py
@@ -0,0 +1,60 @@
+"""BM25-style sparse vectors, computed client-side so the *same* code encodes documents and queries.
+
+Qdrant stores them as a sparse vector with the IDF modifier, so the server contributes IDF from the live
+corpus statistics while we provide the field-weighted, length-normalised term-frequency part:
+
+    weight(term, doc) = tf' * (k1 + 1) / (tf' + k1 * (1 - b + b * len / avg_len))
+
+where tf' counts a term 1.0x in the body, 0.5x as a split sub-token of an identifier (parse_user_id ->
+parse, user, id) and 4x in the symbol/path - mirroring the column weights of the SQLite FTS5 backend.
+Terms are hashed to 32-bit indices (collisions are negligible at repository scale).
+"""
+from __future__ import annotations
+
+import hashlib
+import re
+from collections import Counter
+
+from ..models import Chunk
+from .lexical import STOP, QueryProfile, expand_identifiers, query_tokens
+
+K1, B, AVG_LEN = 1.2, 0.75, 120.0
+_TOK = re.compile(r"[a-z0-9_]+")
+
+
+def term_id(term: str) -> int:
+    return int.from_bytes(hashlib.blake2b(term.encode(), digest_size=4).digest(), "little")
+
+
+def _words(text: str) -> list[str]:
+    return [t for t in _TOK.findall(text.lower()) if t not in STOP and len(t) > 1]
+
+
+def encode_chunk(c: Chunk) -> tuple[list[int], list[float]]:
+    body = _words(c.text)
+    tf: Counter = Counter()
+    for t in body:
+        tf[t] += 1.0
+    for t in _words(expand_identifiers(c.text)):
+        tf[t] += 0.5
+    sym = f"{c.path} {c.symbol}"
+    for t in _words(sym) + _words(expand_identifiers(sym)) + _words(re.sub(r"[/.]", " ", sym)):
+        tf[t] += 4.0
+    dl = max(len(body), 1)
+    norm = K1 * (1 - B + B * dl / AVG_LEN)
+    weights: dict[int, float] = {}
+    for t, f in tf.items():
+        i = term_id(t)
+        weights[i] = max(weights.get(i, 0.0), f * (K1 + 1) / (f + norm))
+    idx = sorted(weights)
+    return idx, [round(weights[i], 4) for i in idx]
+
+
+def encode_query(profile: QueryProfile) -> tuple[list[int], list[float]]:
+    ids = sorted({term_id(t) for t in query_tokens(profile)})
+    return ids, [1.0] * len(ids)
+
+
+def encode_phrase_words(words: list[str]) -> tuple[list[int], list[float]]:
+    ids = sorted({term_id(w) for w in words if w not in STOP and len(w) > 1})
+    return ids, [1.0] * len(ids)
diff --git a/vercel/gitcontext/index/vectorstore.py b/vercel/gitcontext/index/vectorstore.py
new file mode 100644
index 0000000..a5bb717
--- /dev/null
+++ b/vercel/gitcontext/index/vectorstore.py
@@ -0,0 +1,95 @@
+"""Vector store abstraction + Qdrant implementation (embedded local mode, in-memory, or server).
+
+Swapping in Pinecone/Weaviate means implementing the five methods of `VectorStore`;
+nothing else in the codebase touches the vector DB directly.
+"""
+from __future__ import annotations
+
+from typing import Protocol
+
+from ..config import Settings
+
+
+class VectorStore(Protocol):
+    def ensure(self, dim: int) -> None: ...
+    def upsert(self, ids: list[str], vectors: list[list[float]], payloads: list[dict], chunks=None) -> None: ...
+    def delete(self, ids: list[str]) -> None: ...
+    def search(self, vector: list[float], limit: int, source_types=None, path_prefix=None) -> list[tuple[str, float]]: ...
+    def count(self) -> int: ...
+    def reset(self) -> None: ...
+
+
+class QdrantStore:
+    def __init__(self, collection: str, url: str | None = None, api_key: str | None = None,
+                 path: str | None = None, in_memory: bool = False):
+        from qdrant_client import QdrantClient
+
+        self.collection = collection
+        self.remote = bool(url)
+        if url:
+            self.client = QdrantClient(url=url, api_key=api_key)
+        elif in_memory or not path:
+            self.client = QdrantClient(":memory:")
+        else:
+            self.client = QdrantClient(path=str(path))
+
+    def ensure(self, dim: int) -> None:
+        from qdrant_client import models as qm
+
+        names = {c.name for c in self.client.get_collections().collections}
+        if self.collection in names:
+            info = self.client.get_collection(self.collection)
+            existing = info.config.params.vectors.size
+            if existing != dim:
+                raise RuntimeError(f"Collection '{self.collection}' has dim {existing} but embedder produces {dim}. "
+                                   "Re-run `gitcontext index --rebuild` after changing the embedding model.")
+            return
+        self.client.create_collection(self.collection,
+                                      vectors_config=qm.VectorParams(size=dim, distance=qm.Distance.COSINE))
+        if not self.remote:  # payload indexes only exist on a Qdrant server
+            return
+        for f in ("source_type", "path_prefixes", "language", "author"):
+            try:
+                self.client.create_payload_index(self.collection, f, qm.PayloadSchemaType.KEYWORD)
+            except Exception:  # local mode ignores payload indexes
+                pass
+
+    def reset(self) -> None:
+        names = {c.name for c in self.client.get_collections().collections}
+        if self.collection in names:
+            self.client.delete_collection(self.collection)
+
+    def upsert(self, ids, vectors, payloads, chunks=None) -> None:
+        from qdrant_client import models as qm
+
+        for i in range(0, len(ids), 128):
+            self.client.upsert(self.collection, points=[
+                qm.PointStruct(id=ids[j], vector=vectors[j], payload=payloads[j])
+                for j in range(i, min(i + 128, len(ids)))])
+
+    def delete(self, ids) -> None:
+        from qdrant_client import models as qm
+
+        for i in range(0, len(ids), 500):
+            self.client.delete(self.collection, points_selector=qm.PointIdsList(points=ids[i : i + 500]))
+
+    def search(self, vector, limit, source_types=None, path_prefix=None):
+        from qdrant_client import models as qm
+
+        must = []
+        if source_types:
+            must.append(qm.FieldCondition(key="source_type", match=qm.MatchAny(any=list(source_types))))
+        if path_prefix:
+            must.append(qm.FieldCondition(key="path_prefixes", match=qm.MatchValue(value=path_prefix.rstrip("/"))))
+        res = self.client.query_points(self.collection, query=vector, limit=limit,
+                                       query_filter=qm.Filter(must=must) if must else None, with_payload=False)
+        return [(str(p.id), float(p.score)) for p in res.points]
+
+    def count(self) -> int:
+        return self.client.count(self.collection, exact=True).count
+
+
+def make_store(s: Settings) -> QdrantStore:
+    s.work_dir.mkdir(parents=True, exist_ok=True)
+    return QdrantStore(s.collection, url=s.qdrant_url, api_key=s.qdrant_api_key,
+                       path=str(s.qdrant_path), in_memory=s.qdrant_in_memory)
