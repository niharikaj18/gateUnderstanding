+"""GitHub REST ingestion for PR discussions, issues and incident reports (issues labelled
+postmortem/incident/outage/...). Incremental via `since`; tolerant of rate limits."""
+from __future__ import annotations
+
+import re
+import time
+from datetime import datetime, timezone
+
+import httpx
+
+from ..models import Chunk
+
+API = "https://api.github.com"
+INCIDENT_TITLE_RE = re.compile(r"post[-_ ]?mortem|incident|outage|\brca\b|\bsev[ -]?[12]\b", re.I)
+
+
+class GitHubClient:
+    def __init__(self, slug: str, token: str | None = None, transport: httpx.BaseTransport | None = None):
+        self.slug = slug
+        headers = {"Accept": "application/vnd.github+json", "X-GitHub-Api-Version": "2022-11-28",
+                   "User-Agent": "gitcontext"}
+        if token:
+            headers["Authorization"] = f"Bearer {token}"
+        self.warnings: list[str] = []
+        self.http = httpx.Client(base_url=API, headers=headers, timeout=30, transport=transport)
+
+    def _get(self, url: str, params: dict | None = None) -> httpx.Response | None:
+        for attempt in range(3):
+            r = self.http.get(url, params=params)
+            if r.status_code in (403, 429) and r.headers.get("x-ratelimit-remaining") == "0":
+                self.warnings.append("GitHub rate limit exhausted (set GITHUB_TOKEN); PR/issue data may be partial")
+                return None  # degrade gracefully, caller keeps what it has
+            if r.status_code >= 500:
+                time.sleep(1.5 * (attempt + 1))
+                continue
+            if r.status_code >= 400:
+                self.warnings.append(f"GitHub API {r.status_code} for {url}")
+                return None
+            return r
+        return None
+
+    def _paged(self, url: str, params: dict, limit: int):
+        n, page = 0, 1
+        while n < limit:
+            r = self._get(url, {**params, "per_page": 100, "page": page})
+            if r is None:
+                return
+            items = r.json()
+            if not items:
+                return
+            for it in items:
+                yield it
+                n += 1
+                if n >= limit:
+                    return
+            if len(items) < 100:
+                return
+            page += 1
+
+    # ---- thread rendering ------------------------------------------------------------
+    @staticmethod
+    def _user(o: dict) -> str:
+        return (o.get("user") or {}).get("login", "unknown")
+
+    def _comments(self, number: int, is_pr: bool) -> list[dict]:
+        out = [dict(c, _kind="comment") for c in self._paged(f"/repos/{self.slug}/issues/{number}/comments", {}, 100)]
+        if is_pr:
+            out += [dict(c, _kind="review-comment") for c in self._paged(f"/repos/{self.slug}/pulls/{number}/comments", {}, 100)]
+            out += [dict(c, _kind="review", body=c.get("body") or "") for c in
+                    self._paged(f"/repos/{self.slug}/pulls/{number}/reviews", {}, 50) if c.get("body")]
+        return sorted(out, key=lambda c: c.get("created_at") or c.get("submitted_at") or "")
+
+    def _to_chunks(self, item: dict, st: str, max_chars: int, is_pr: bool) -> list[Chunk]:
+        n = item["number"]
+        labels = [lb["name"] for lb in item.get("labels", [])]
+        title, body = item.get("title", ""), item.get("body") or ""
+        head = f"{'Pull request' if is_pr else 'Issue'} #{n}: {title}\nState: {item.get('state')}  Labels: {', '.join(labels) or '-'}\n\n{body}".strip()
+        blocks = [head]
+        if item.get("comments", 0) or is_pr:
+            for c in self._comments(n, is_pr):
+                path = f" on {c['path']}" if c.get("path") else ""
+                blocks.append(f"[{c['_kind']}{path}] @{self._user(c)}: {(c.get('body') or '').strip()}")
+        # pack blocks into chunks <= max_chars (never split a comment unless it alone is too long)
+        chunks, cur = [], ""
+        for b in blocks:
+            for piece in [b[i : i + max_chars] for i in range(0, len(b), max_chars)] or [""]:
+                if cur and len(cur) + len(piece) + 2 > max_chars:
+                    chunks.append(cur)
+                    cur = ""
+                cur += ("\n\n" if cur else "") + piece
+        if cur:
+            chunks.append(cur)
+        return [Chunk(source_type=st, text=t, kind="pr" if is_pr else "issue", author=self._user(item),
+                      date=item.get("updated_at") or item.get("created_at") or "", pr_number=n,
+                      url=item.get("html_url", ""), part=i,
+                      extra={"title": title, "labels": labels, "state": item.get("state")})
+                for i, t in enumerate(chunks)]
+
+    # ---- public API ------------------------------------------------------------------------
+    def fetch(self, since: str | None, max_prs: int, max_issues: int, incident_labels: list[str],
+              max_chars: int = 2400) -> list[Chunk]:
+        labels_l = {x.strip().lower() for x in incident_labels}
+        self.warnings.clear()
+        out: list[Chunk] = []
+        for pr in self._paged(f"/repos/{self.slug}/pulls",
+                              {"state": "all", "sort": "updated", "direction": "desc"}, max_prs):
+            if since and (pr.get("updated_at") or "") <= since:
+                break
+            out += self._to_chunks(pr, "pr", max_chars, True)
+        params = {"state": "all", "sort": "updated", "direction": "desc"}
+        if since:
+            params["since"] = since
+        for it in self._paged(f"/repos/{self.slug}/issues", params, max_issues):
+            if "pull_request" in it:  # the issues endpoint also returns PRs
+                continue
+            names = {lb["name"].lower() for lb in it.get("labels", [])}
+            is_incident = bool(names & labels_l) or bool(INCIDENT_TITLE_RE.search(it.get("title", "")))
+            out += self._to_chunks(it, "incident" if is_incident else "issue", max_chars, False)
+        return out
+
+    @staticmethod
+    def now_iso() -> str:
+        return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
diff --git a/vercel/gitcontext/ingest/repo.py b/vercel/gitcontext/ingest/repo.py
new file mode 100644
index 0000000..1587180
--- /dev/null
+++ b/vercel/gitcontext/ingest/repo.py
@@ -0,0 +1,190 @@
+"""Thin wrapper around the git CLI. Content is always read from git objects (HEAD),
+never the working tree, so indexing is reproducible and tied to a commit SHA."""
+from __future__ import annotations
+
+import re
+import subprocess
+from collections import Counter
+from dataclasses import dataclass
+from pathlib import Path
+
+from ..models import Chunk
+
+RS, US = "\x1e", "\x1f"
+PR_RE = re.compile(r"\(#(\d+)\)|[Mm]erge pull request #(\d+)|\bPR[ #]*(\d+)\b")
+
+
+class GitError(RuntimeError):
+    pass
+
+
+@dataclass
+class FileMeta:
+    sha: str = ""
+    author: str = ""
+    date: str = ""
+    subject: str = ""
+    pr_number: int | None = None
+    top_authors: list[str] | None = None
+
+
+def pr_from_message(msg: str) -> int | None:
+    m = PR_RE.search(msg or "")
+    return int(next(g for g in m.groups() if g)) if m else None
+
+
+class GitRepo:
+    def __init__(self, path: Path, remote_url: str | None = None):
+        self.path = Path(path)
+        self.remote_url = remote_url
+
+    # ---- plumbing -----------------------------------------------------------
+    def git(self, *args: str, check: bool = True, input: bytes | None = None) -> bytes:
+        p = subprocess.run(["git", "-C", str(self.path), *args], capture_output=True, input=input)
+        if check and p.returncode != 0:
+            raise GitError(f"git {' '.join(args)} failed: {p.stderr.decode(errors='replace')[:400]}")
+        return p.stdout
+
+    def text(self, *args: str, **kw) -> str:
+        return self.git(*args, **kw).decode("utf-8", errors="replace")
+
+    # ---- acquisition ----------------------------------------------------------
+    @classmethod
+    def open_or_clone(cls, repo: str, work_dir: Path, token: str | None = None) -> "GitRepo":
+        local = Path(repo).expanduser()
+        if local.exists() and (local / ".git").exists() or (local.exists() and (local / "HEAD").exists()):
+            return cls(local.resolve())
+        url = repo if "://" in repo or repo.startswith("git@") else f"https://github.com/{repo}"
+        dest = work_dir / "clone"
+        if not dest.exists():
+            dest.parent.mkdir(parents=True, exist_ok=True)
+            auth = url.replace("https://", f"https://x-access-token:{token}@") if token and url.startswith("https://") else url
+            p = subprocess.run(["git", "clone", "--quiet", auth, str(dest)], capture_output=True)
+            if p.returncode != 0:
+                raise GitError(f"clone failed: {p.stderr.decode(errors='replace')[:400]}")
+            subprocess.run(["git", "-C", str(dest), "remote", "set-url", "origin", url], capture_output=True)
+        return cls(dest, remote_url=url)
+
+    @property
+    def is_clone(self) -> bool:
+        return self.remote_url is not None
+
+    def pull(self) -> bool:
+        """Fast-forward a managed clone. Returns True if HEAD moved. No-op for user-owned local repos."""
+        if not self.is_clone:
+            return False
+        before = self.head()
+        self.git("fetch", "--quiet", "origin", check=False)
+        self.git("merge", "--ff-only", "--quiet", "FETCH_HEAD", check=False)
+        return self.head() != before
+
+    # ---- tree -----------------------------------------------------------------------
+    def head(self) -> str:
+        return self.text("rev-parse", "HEAD").strip()
+
+    def branch(self) -> str:
+        return self.text("rev-parse", "--abbrev-ref", "HEAD", check=False).strip()
+
+    def ls_tree(self, rev: str = "HEAD") -> dict[str, tuple[str, int]]:
+        """path -> (blob_sha, size)"""
+        out = self.text("ls-tree", "-r", "-l", "-z", rev)
+        res = {}
+        for ent in out.split("\0"):
+            if not ent:
+                continue
+            meta, path = ent.split("\t", 1)
+            _mode, typ, sha, size = meta.split()
+            if typ == "blob":
+                res[path] = (sha, int(size) if size.isdigit() else 0)
+        return res
+
+    def read_blobs(self, shas: list[str]) -> dict[str, str]:
+        """Batch-read blobs via `git cat-file --batch`."""
+        if not shas:
+            return {}
+        p = subprocess.run(["git", "-C", str(self.path), "cat-file", "--batch"], capture_output=True,
+                           input=("\n".join(shas) + "\n").encode())
+        data, i, out = p.stdout, 0, {}
+        for sha in shas:
+            nl = data.index(b"\n", i)
+            header = data[i:nl].decode().split()
+            if len(header) < 3:
+                i = nl + 1
+                continue
+            size = int(header[2])
+            body = data[nl + 1 : nl + 1 + size]
+            i = nl + 1 + size + 1
+            if b"\0" in body[:8000]:
+                continue  # binary
+            out[sha] = body.decode("utf-8", errors="replace")
+        return out
+
+    def diff_names(self, old: str, new: str = "HEAD") -> tuple[list[str], list[str]]:
+        """(changed_or_added, deleted) paths between two commits."""
+        out = self.text("diff", "--name-status", "--no-renames", "-z", old, new)
+        parts = [x for x in out.split("\0") if x]
+        changed, deleted = [], []
+        for i in range(0, len(parts) - 1, 2):
+            (deleted if parts[i].startswith("D") else changed).append(parts[i + 1])
+        return changed, deleted
+
+    def commit_exists(self, sha: str) -> bool:
+        if not sha:
+            return False
+        p = subprocess.run(["git", "-C", str(self.path), "cat-file", "-e", f"{sha}^{{commit}}"], capture_output=True)
+        return p.returncode == 0
+
+    # ---- history ----------------------------------------------------------------------
+    def file_meta(self, max_commits: int = 5000) -> dict[str, FileMeta]:
+        """Last-modifying commit and top authors per file, from a single pass over `git log`."""
+        fmt = f"{RS}%H{US}%an{US}%aI{US}%s"
+        out = self.text("log", f"-n{max_commits}", "--no-merges", "--name-only", f"--pretty=format:{fmt}", check=False)
+        meta: dict[str, FileMeta] = {}
+        authors: dict[str, Counter] = {}
+        for rec in out.split(RS):
+            if not rec.strip():
+                continue
+            head, *files = rec.split("\n")
+            sha, author, date, subject = (head.split(US) + [""] * 4)[:4]
+            for f in (x for x in files if x.strip()):
+                authors.setdefault(f, Counter())[author] += 1
+                if f not in meta:
+                    meta[f] = FileMeta(sha, author, date, subject, pr_from_message(subject))
+        for f, m in meta.items():
+            m.top_authors = [a for a, _ in authors[f].most_common(3)]
+        return meta
+
+    def file_meta_for(self, paths: list[str]) -> dict[str, FileMeta]:
+        res = {}
+        for p in paths:
+            out = self.text("log", "-n1", f"--pretty=format:%H{US}%an{US}%aI{US}%s", "--", p, check=False)
+            if out.strip():
+                sha, author, date, subject = (out.split(US) + [""] * 4)[:4]
+                names = self.text("log", "-n200", "--pretty=format:%an", "--", p, check=False).split("\n")
+                res[p] = FileMeta(sha, author, date, subject, pr_from_message(subject),
+                                  [a for a, _ in Counter(n for n in names if n).most_common(3)])
+        return res
+
+    def commits(self, since_sha: str | None = None, limit: int = 2000) -> list[Chunk]:
+        """Commit history as chunks (subject + body + touched files)."""
+        fmt = f"{RS}%H{US}%an{US}%aI{US}%s{US}%b{US}"
+        rng = f"{since_sha}..HEAD" if since_sha and self.commit_exists(since_sha) else "HEAD"
+        out = self.text("log", rng, f"-n{limit}", "--no-merges", "--name-only", f"--pretty=format:{fmt}", check=False)
+        chunks = []
+        for rec in out.split(RS):
+            if not rec.strip():
+                continue
+            parts = rec.split(US)
+            if len(parts) < 6:
+                continue
+            sha, author, date, subject, body, files_blob = parts[:6]
+            files = [f for f in files_blob.split("\n") if f.strip()]
+            shown = files[:25] + ([f"... (+{len(files) - 25} more)"] if len(files) > 25 else [])
+            text = f"{subject}\n\n{body.strip()}\n\nFiles changed:\n" + "\n".join(f"- {f}" for f in shown)
+            pr = pr_from_message(subject + " " + body)
+            url = ""
+            if self.remote_url and "github.com" in self.remote_url:
+                url = f"{self.remote_url.removesuffix('.git')}/commit/{sha}"
+            chunks.append(Chunk(source_type="commit", text=text.strip(), kind="commit", author=author, date=date,
+                                commit_sha=sha, pr_number=pr, url=url, extra={"files": files[:100], "subject": subject}))
+        return chunks
