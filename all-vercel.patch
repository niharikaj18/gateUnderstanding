+  .card { border: 1px solid var(--line); border-radius: 10px; margin-top: 8px; background: var(--bg); }
+  .card.hl { outline: 2px solid var(--accent); }
+  .card > summary { cursor: pointer; padding: 8px 12px; font-size: 13.5px; list-style: none; display: flex; gap: 8px; align-items: baseline; flex-wrap: wrap; }
+  .card > summary::-webkit-details-marker { display: none; }
+  .card .n { font-weight: 700; color: var(--chip-ink); } .card .badge { font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
+  .card .lbl { font-family: var(--mono); font-size: 12.5px; overflow-wrap: anywhere; } .card.cited .n::after { content: " ✓"; color: var(--ok); }
+  .card .body { padding: 0 12px 12px; } .meta { color: var(--muted); font-size: 12px; margin: 0 0 8px; }
+  .meta a { color: var(--accent); }
+  .timing { color: var(--muted); font-size: 12px; margin-top: 8px; }
+  footer { border-top: 1px solid var(--line); padding: 10px 16px; }
+  form { display: flex; gap: 8px; }
+  textarea { flex: 1; resize: none; font: inherit; color: var(--ink); background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 9px 12px; max-height: 140px; }
+  textarea:focus, input:focus, select:focus { outline: 2px solid var(--accent); outline-offset: -1px; }
+  .settings { display: none; border-bottom: 1px solid var(--line); padding: 12px 16px; background: var(--panel); font-size: 13.5px; }
+  .settings.open { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
+  .settings label { display: grid; gap: 4px; color: var(--muted); } .settings .row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; color: var(--ink); }
+  input[type=text], select { font: inherit; color: var(--ink); background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: 5px 8px; width: 100%; }
+  .sr { position: absolute; left: -9999px; }
+</style>
+</head>
+<body>
+<div class="app">
+  <header>
+    <h1>🧭 GitContext</h1>
+    <span class="repo" id="repo"></span>
+    <span class="spacer"></span>
+    <span class="pill" id="status" role="status" aria-live="polite">connecting…</span>
+    <button class="btn" id="sync" hidden>Sync changes</button>
+    <button class="btn" id="gear" aria-expanded="false" aria-controls="settings">Settings</button>
+  </header>
+
+  <section class="settings" id="settings" aria-label="Settings">
+    <label>Evidence chunks (top-k): <b id="kval">8</b>
+      <input type="range" id="topk" min="3" max="20" value="8"></label>
+    <label>Retrieval
+      <select id="mode"><option value="hybrid">Hybrid (vector + BM25 + exact)</option><option value="dense">Vector only</option><option value="bm25">Keyword only</option></select></label>
+    <label>Path filter (prefix)
+      <input type="text" id="prefix" placeholder="e.g. src/billing" autocomplete="off"></label>
+    <div>
+      <div style="color:var(--muted);margin-bottom:4px">Sources</div>
+      <div class="row" id="sources"></div>
+    </div>
+    <label>API base URL
+      <input type="text" id="apibase" placeholder="/api" autocomplete="off"></label>
+    <div class="row"><label class="row"><input type="checkbox" id="rerank" checked> Cross-encoder rerank</label>
+      <button class="btn" id="theme" type="button">Toggle theme</button></div>
+  </section>
+
+  <main id="chat" aria-live="polite">
+    <div class="hint" id="hint">
+      <h2>Ask your codebase</h2>
+      <div>Answers are grounded in code, docs, commits, PR discussions and incident reports, and every claim links to its source.</div>
+      <div class="examples" id="examples"></div>
+    </div>
+  </main>
+
+  <footer>
+    <form id="form">
+      <label class="sr" for="q">Question</label>
+      <textarea id="q" rows="1" placeholder="Where is retry handled, and why was it changed?" maxlength="2000"></textarea>
+      <button class="btn primary" id="send" type="submit">Ask</button>
+    </form>
+  </footer>
+</div>
+
+<script>
+"use strict";
+const $ = (id) => document.getElementById(id);
+const ICON = { code: "🧩", doc: "📄", commit: "🔀", pr: "🔃", issue: "🐞", incident: "🚨" };
+const EXAMPLES = [
+  "How is this project structured and where should I start reading?",
+  "Where is error handling implemented?",
+  "Why was the most recent major change made, and who made it?",
+];
+const LS = (() => { try { localStorage.setItem("_t", "1"); localStorage.removeItem("_t"); return localStorage; } catch { return null; } })();
+const store = {
+  get: (k, d) => { try { const v = LS && LS.getItem("gc:" + k); return v === null || v === undefined ? d : JSON.parse(v); } catch { return d; } },
+  set: (k, v) => { try { LS && LS.setItem("gc:" + k, JSON.stringify(v)); } catch { /* storage unavailable */ } },
+};
+
+// ---------- safe rendering: escape first, then apply a small markdown subset ----------
+function esc(s) {
+  return String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
+}
+function inline(escaped, maxCite) {
+  return escaped
+    .replace(/`([^`\n]+)`/g, "<code>$1</code>")
+    .replace(/\*\*([^*\n]+)\*\*/g, "<strong>$1</strong>")
+    .replace(/(^|[\s(])_([^_\n]+)_(?=[\s).,:;]|$)/g, "$1<em>$2</em>")
+    .replace(/\[(\d{1,3})\]/g, (m, n) => (+n >= 1 && +n <= maxCite ? `<button class="cite" type="button" data-n="${n}" aria-label="Evidence ${n}">${n}</button>` : m));
+}
+function renderMarkdown(text, maxCite) {
+  return String(text).split("```").map((part, i) => {
+    if (i % 2) { const nl = part.indexOf("\n"); return `<pre><code>${esc(nl >= 0 ? part.slice(nl + 1) : part)}</code></pre>`; }
+    return part.split(/\n{2,}/).map((blk) => {
+      const lines = blk.split("\n").filter((l) => l.trim());
+      if (!lines.length) return "";
+      if (lines.every((l) => /^\s*([-*•]|\d+\.)\s+/.test(l)))
+        return "<ul>" + lines.map((l) => `<li>${inline(esc(l.replace(/^\s*([-*•]|\d+\.)\s+/, "")), maxCite)}</li>`).join("") + "</ul>";
+      return `<p>${inline(esc(lines.join("\n")), maxCite).replace(/\n/g, "<br>")}</p>`;
+    }).join("");
+  }).join("");
+}
+const safeUrl = (u) => (/^https?:\/\//i.test(u || "") ? u : "");
+
+// ---------- API ----------
+const base = () => ($("apibase").value.trim() || "/api").replace(/\/+$/, "");
+async function api(path, opts = {}) {
+  let r;
+  try { r = await fetch(base() + path, { headers: { "content-type": "application/json" }, ...opts }); }
+  catch (e) { throw new Error("Could not reach the API. Check the API base URL in Settings."); }
+  let data = null;
+  try { data = await r.json(); } catch { /* non-JSON error body */ }
+  if (!r.ok) {
+    const detail = data && (typeof data.detail === "string" ? data.detail : JSON.stringify(data.detail));
+    const hint = r.status === 401 ? " (the proxy’s BACKEND_API_KEY doesn’t match the backend’s GITCONTEXT_API_KEY)" : "";
+    throw new Error(`${r.status}: ${detail || r.statusText}${hint}`);
+  }
+  return data;
+}
+
+// ---------- status ----------
+let status = null;
+async function refreshStatus() {
+  const pill = $("status");
+  try {
+    status = await api("/status");
+    $("repo").textContent = (status.repo || "").replace(/^https?:\/\//, "") + (status.branch ? " @ " + status.branch : "");
+    const running = status.job && status.job.running;
+    if (running) { pill.className = "pill warn"; pill.textContent = "indexing…"; }
+    else if (!status.indexed) { pill.className = "pill bad"; pill.textContent = "not indexed yet"; }
+    else if (status.stale) { pill.className = "pill warn"; pill.textContent = status.stale_files.total == null ? "stale · new commits" : `stale · ${status.stale_files.total} changed file(s)`; }
+    else { pill.className = "pill ok"; pill.textContent = `fresh @ ${status.indexed_commit.slice(0, 7)}`; }
+    $("sync").hidden = !(status.indexed && status.stale && !running && status.can_sync !== false);
+    pill.title = Object.entries(status.chunks || {}).map(([k, v]) => `${k}: ${v}`).join(" · ");
+  } catch (e) {
+    pill.className = "pill bad"; pill.textContent = "backend unreachable"; pill.title = e.message;
+  }
+}
+
+// ---------- chat ----------
+function el(tag, cls, text) { const e = document.createElement(tag); if (cls) e.className = cls; if (text !== undefined) e.textContent = text; return e; }
+
+function evidenceCard(e, i, cited) {
+  const card = el("details", "card" + (cited ? " cited" : ""));
+  const sum = el("summary");
+  sum.append(el("span", "n", `[${i}]`), el("span", "badge", `${ICON[e.source_type] || ""} ${e.source_type}`),
+             el("span", "lbl", e.start_line ? `${e.path}:${e.start_line}-${e.end_line}` : (e.path || e.key)));
+  if (e.symbol && e.source_type === "code") sum.append(el("span", "badge", e.symbol));
+  const body = el("div", "body");
+  const meta = el("p", "meta");
+  const bits = [];
+  if (e.author) bits.push("👤 " + e.author);
+  if (e.date) bits.push("📅 " + e.date.slice(0, 10));
+  if (e.commit_sha && e.source_type !== "commit") bits.push("commit " + e.commit_sha.slice(0, 7));
+  if (e.pr_number) bits.push("PR #" + e.pr_number);
+  if (e.ranks && Object.keys(e.ranks).length) bits.push("found by " + Object.entries(e.ranks).map(([k, v]) => `${k} #${v}`).join(", "));
+  meta.append(document.createTextNode(bits.join(" · ")));
+  const url = safeUrl(e.url);
+  if (url) { meta.append(document.createTextNode(" · ")); const a = el("a", "", "open source"); a.href = url; a.target = "_blank"; a.rel = "noopener noreferrer"; meta.append(a); }
+  const pre = el("pre"); pre.append(el("code", "", (e.text || "").slice(0, 2500)));
+  body.append(meta, pre);
+  card.append(sum, body);
+  return card;
+}
+
+function renderAnswer(data) {
+  const wrap = el("div", "a");
+  const ev = data.evidence || [];
+  const citedNums = new Set((data.citations || []).map((c) => c.n));
+  const text = el("div"); text.innerHTML = renderMarkdown(data.answer || "", ev.length);
+  wrap.append(text);
+  (data.warnings || []).forEach((w) => wrap.append(el("div", "warn-box", w)));
+  if (data.index_status && data.index_status.behind_head) wrap.append(el("div", "warn-box", "The index is behind the repository HEAD, so recent changes may be missing."));
+  if (ev.length) {
+    const d = el("details", "ev"); d.append(el("summary", "", `Evidence (${ev.length} chunks)`));
+    const cards = ev.map((e, i) => evidenceCard(e, i + 1, citedNums.has(i + 1)));
+    cards.forEach((c) => d.append(c));
+    wrap.append(d);
+    text.addEventListener("click", (evt) => {
+      const b = evt.target.closest(".cite"); if (!b) return;
+      const card = cards[+b.dataset.n - 1]; if (!card) return;
+      d.open = true; card.open = true; card.classList.add("hl");
+      card.scrollIntoView({ block: "center", behavior: "smooth" });
+      setTimeout(() => card.classList.remove("hl"), 1600);
+    });
+  }
+  const t = data.timings_ms || {};
+  if (t.total_ms) wrap.append(el("div", "timing", `${Math.round(t.total_ms)} ms · ${data.model || ""}` + (t.rerank ? ` · rerank ${Math.round(t.rerank)} ms` : "")));
+  return wrap;
+}
+
+function selectedSources() { return [...document.querySelectorAll("#sources input:checked")].map((i) => i.value); }
+
+async function ask(question) {
+  question = question.trim(); if (!question) return;
+  $("hint")?.remove();
+  const chat = $("chat"), msg = el("div", "msg");
+  msg.append(el("div", "q", question));
+  const holder = el("div", "a loading", "Retrieving and reasoning");
+  msg.append(holder); chat.append(msg); chat.scrollTop = chat.scrollHeight;
+  $("send").disabled = true;
+  try {
+    const src = selectedSources();
+    const data = await api("/query", { method: "POST", body: JSON.stringify({
+      question, top_k: +$("topk").value, mode: $("mode").value, rerank: $("rerank").checked,
+      source_types: src.length && src.length < Object.keys(ICON).length ? src : null, path_prefix: $("prefix").value.trim() || null }) });
+    holder.replaceWith(renderAnswer(data));
+  } catch (e) {
+    holder.className = "a err"; holder.textContent = e.message;
+  } finally {
+    $("send").disabled = false; chat.scrollTop = chat.scrollHeight; refreshStatus();
+  }
+}
+
+// ---------- wiring ----------
+function init() {
+  Object.keys(ICON).forEach((t) => {
+    const l = el("label", "row"); const i = el("input"); i.type = "checkbox"; i.value = t; i.checked = true;
+    l.append(i, document.createTextNode(`${ICON[t]} ${t}`)); $("sources").append(l);
+  });
+  EXAMPLES.forEach((q) => { const b = el("button", "", q); b.type = "button"; b.onclick = () => ask(q); $("examples").append(b); });
+
+  $("topk").value = store.get("topk", 8); $("kval").textContent = $("topk").value;
+  $("mode").value = store.get("mode", "hybrid"); $("rerank").checked = store.get("rerank", true);
+  $("prefix").value = store.get("prefix", ""); $("apibase").value = store.get("apibase", "/api");
+  const theme = store.get("theme", null); if (theme) document.documentElement.dataset.theme = theme;
+
+  $("topk").oninput = () => { $("kval").textContent = $("topk").value; store.set("topk", +$("topk").value); };
+  $("mode").onchange = () => store.set("mode", $("mode").value);
+  $("rerank").onchange = () => store.set("rerank", $("rerank").checked);
+  $("prefix").onchange = () => store.set("prefix", $("prefix").value);
+  $("apibase").onchange = () => { store.set("apibase", $("apibase").value); refreshStatus(); };
+  $("theme").onclick = () => {
+    const dark = document.documentElement.dataset.theme === "dark" || (!document.documentElement.dataset.theme && matchMedia("(prefers-color-scheme: dark)").matches);
+    document.documentElement.dataset.theme = dark ? "light" : "dark"; store.set("theme", document.documentElement.dataset.theme);
+  };
+  $("gear").onclick = () => { const o = $("settings").classList.toggle("open"); $("gear").setAttribute("aria-expanded", o); };
+  $("sync").onclick = async () => {
+    $("sync").disabled = true; $("status").textContent = "syncing…";
+    try { await api("/sync", { method: "POST", body: "{}" }); } catch (e) { $("status").className = "pill bad"; $("status").textContent = e.message.slice(0, 80); $("status").title = e.message; }
+    $("sync").disabled = false; refreshStatus();
+  };
+  $("form").onsubmit = (e) => { e.preventDefault(); const v = $("q").value; $("q").value = ""; $("q").style.height = "auto"; ask(v); };
+  $("q").onkeydown = (e) => { if (e.key === "Enter" && !e.shiftKey && !e.isComposing) { e.preventDefault(); $("form").requestSubmit(); } };
+  $("q").oninput = () => { const t = $("q"); t.style.height = "auto"; t.style.height = Math.min(t.scrollHeight, 140) + "px"; };
+
+  refreshStatus(); setInterval(refreshStatus, 30000);
+}
+init();
+</script>
+</body>
+</html>
