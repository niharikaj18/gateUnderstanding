+  pre code { background: none; border: 0; padding: 0; font: inherit; }
+  .cite { font: 600 11px var(--sans); background: var(--chip); color: var(--chip-ink); border: 0; border-radius: 6px; padding: 1px 6px; margin: 0 1px; vertical-align: 1px; }
+  .warn-box { margin-top: 10px; font-size: 13px; color: var(--warn); border: 1px solid var(--warn); border-radius: 8px; padding: 7px 10px; }
+  .err { color: var(--bad); border-color: var(--bad); }
+  .loading { color: var(--muted); } .loading::after { content: ""; display: inline-block; width: 1.2em; animation: dots 1.2s steps(4, end) infinite; overflow: hidden; vertical-align: bottom; }
+  @keyframes dots { 0% { width: 0 } 100% { width: 1.2em } }
